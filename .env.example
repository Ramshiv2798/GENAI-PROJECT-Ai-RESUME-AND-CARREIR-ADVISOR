# Copy this file to .env and replace the dummy value. Never commit .env.
GROQ_API_KEY=your_groq_api_key_here
# Use this model. (qwen/qwen3.8-27b has only 1,000 output tokens/minute on the free plan -> constant 429 errors.)
MODEL_NAME=openai/gpt-oss-120b

# Optional local history of analysis summaries (never the resume text). Keep OFF on a public website.
ENABLE_HISTORY=1
# HISTORY_FILE=data/history.jsonl
